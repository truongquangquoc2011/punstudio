{
  "name": "punstudio",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1430",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1430",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "process": "tsx scripts/process.ts",
    "app": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win nsis --x64",
    "icon": "node scripts/make-icon.cjs",
    "release": "vite build && electron-builder --win nsis --x64 --publish always"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@fontsource/ibm-plex-sans": "^5.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "manifold-3d": "^3.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.5",
    "three": "^0.170.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "description": "Chuẩn hóa mâm xe STL về kích thước chuẩn và thêm khối trụ + lỗ trục.",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.punstudio.app",
    "productName": "Punstudio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Punstudio",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "installerLanguages": [
        "vi_VN"
      ],
      "multiLanguageInstaller": true,
      "artifactName": "Punstudio-Setup-${version}.exe",
      "displayLanguageSelector": false
    },
    "publish": {
      "provider": "github",
      "owner": "truongquangquoc2011",
      "repo": "punstudio"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
